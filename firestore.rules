rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo los correos de esta lista pueden administrar el sitio.
    // Importante: cualquiera puede crear una cuenta en Firebase Auth,
    // por eso no basta con "estar logueado"; se revisa el correo.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['CORREO_ADMIN'];
    }

    // Teléfono, correo, WhatsApp y foto de perfil: los lee la página,
    // solo el admin los cambia.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Propiedades: públicas para leer, solo el admin las crea o edita.
    match /properties/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Opiniones: cualquiera puede dejar una, pero entra como "pendiente"
    // y solo el admin la publica, la edita o la borra.
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'rating', 'comment', 'date', 'approved'])
        && request.resource.data.approved == false
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.comment is string && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 1000
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.date is string;
      allow update, delete: if isAdmin();
    }
  }
}
